# Database Settings (MySQL / MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=charitage
DB_USER=root
DB_PASS=

# JWT Authentication
JWT_SECRET_KEY=your-random-32-char-secret-key-here
