{
  "name": "charitage/backend-php",
  "description": "Charitage Foundation PHP Backend API with Razorpay Integration",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-openssl": "*"
  },
  "suggest": {
    "razorpay/razorpay": "Official Razorpay PHP SDK",
    "firebase/php-jwt": "Official Firebase PHP JWT library"
  },
  "scripts": {
    "start": "php -S 127.0.0.1:8000 index.php"
  }
}
